	"name": "cypress-javascript-test-automation",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"cy:open": "cypress open",
		"cy:run": "cypress run --browser chrome",
		"test": "cypress run --browser chrome",
		"test:smoke": "cypress run --browser chrome --expose grepTags=\"@smoke\",grepFilterSpecs=true,grepOmitFiltered=true",
		"test:regression": "cypress run --browser chrome",
